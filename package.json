{
  "name": "upbit-ml-trader",
  "version": "4.0.0",
  "description": "Upbit ML-based Intraday Trading Bot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "dotenv -e .env -- node src/index.js",
    "backfill:candles": "dotenv -e .env -- node scripts/backfill-candles.js",
    "train:ml": "dotenv -e .env -- node scripts/train-ml-model.js",
    "train:ml:trades": "dotenv -e .env -- node scripts/train-ml-trades.js",
    "train:ml:regime": "dotenv -e .env -- node scripts/train-ml-regime.js",
    "validate:walkforward": "dotenv -e .env -- node scripts/walkforward-validate.js"
  },
  "keywords": [
    "upbit",
    "crypto",
    "trading",
    "bot",
    "high-winrate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "axios": "^1.6.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0",
    "nodemon": "^3.0.1"
  }
}
