ATR_PERIOD=14
ATR_P_LO=0.35
ATR_P_HI=0.9
MIN_ATR_PCT=0.038

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
