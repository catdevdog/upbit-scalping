POSITION_PCT_MAX=0.25         # 25% (기존 90% → 25%로 축소)
RISK_PCT_PER_TRADE=0.01       # 1% 리스크 활성화 (기존 0 → 1%)
MIN_ORDER_KRW=5000            # 최소 주문 금액
MAX_ORDER_KRW=1000000         # 100만원 상한 (기존 무제한 → 100만원)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 전략 - TP/SL [개선 1: 현실적 인트라데이 수준으로 조정]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TP=0.008                      # 0.8% 목표 (기존 4.5% → 0.8%)
SL=0.005                      # 0.5% 손절 (기존 2.0% → 0.5%)
FEE=0.0005                    # 0.05% 수수료
# SLIP: 동적 계산됨 (기본값 0.08%)

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
