MIN_BEST_BID_SHARE=0.58

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 전략 - RSI
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RSI_MIN=45
RSI_MAX=70
RSI_OPTIMAL_MIN=50
RSI_OPTIMAL_MAX=64

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 전략 - 확률
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MIN_PROB_ENTRY=0.72
PROB_BUFFER=0.06

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 전략 - 청산 [개선 5: TIMEOUT 시간 단축]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TIMEOUT_SEC=1800              # 30분 (기존 6시간 → 30분)
STALL_SEC=600                 # 10분 (기존 1시간 → 10분)
BE_TRIGGER=0.003              # 0.3% 도달 시 BE 이동
BE_OFFSET=0.001               # BE는 진입가 +0.1%
TRAIL_PCT=0.002               # 트레일링 0.2%

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 레인지 모드 (횡보장 평균회귀 전략) [v4.2 추가]
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
RANGE_MODE_ENABLED=true       # 레인지 모드 활성화

# 모드 판단 기준 (ATR 비율)
MODE_ATR_TREND=1.2            # ATR 비율 1.2배 이상 → TREND
MODE_ATR_RANGE=0.8            # ATR 비율 0.8배 이하 → RANGE
MODE_ATR_LOOKBACK=30          # 30봉 평균 기준
MODE_COOLDOWN_SEC=300         # 모드 전환 쿨다운 5분

# 볼린저밴드 설정
RANGE_BB_PERIOD=20            # BB 기간
RANGE_BB_STDDEV=2             # BB 표준편차 배수
RANGE_BB_MARGIN=0.001         # BB 밴드 여유 0.1%

# RSI 기준
RANGE_RSI_OVERSOLD=35         # RSI 과매도 기준
RANGE_RSI_OVERBOUGHT=65       # RSI 과매수 기준

# 손익 설정 (p* = 38.5%)
RANGE_TP=0.004                # 0.4% 목표
RANGE_SL=0.0025               # 0.25% 손절
RANGE_TIMEOUT=600             # 10분 타임아웃

# 포지션/제한
RANGE_POSITION_PCT=0.10       # 10% 포지션 (보수적)
RANGE_MAX_DAILY_TRADES=5      # 일일 최대 5회
RANGE_MAX_CONSEC_LOSSES=2     # 연속 2회 손실 시 당일 중단

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
